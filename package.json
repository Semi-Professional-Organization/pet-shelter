{
  "name": "pet-shelter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run docs:check",
    "arch:check": "node docs/architecture/layer-graph.mjs",
    "docs:check": "node scripts/check-doc-invariants.mjs",
    "commit:check": "node scripts/commit-msg.mjs",
    "commit:audit": "node scripts/commit-msg.mjs --audit",
    "commit:hook": "node scripts/install-git-hooks.mjs commit-msg",
    "ledger:issues": "node scripts/ledger-issues.mjs",
    "pretest": "npm run db:generate",
    "test": "vitest run --project unit tests/unit",
    "pretest:watch": "npm run db:generate",
    "test:watch": "vitest",
    "pretest:components": "npm run db:generate",
    "test:components": "vitest run --project components",
    "pretest:integration": "npm run db:generate",
    "test:integration": "cross-env STRICT_PERSISTENCE=true vitest run --project integration",
    "test:db": "cross-env DATABASE_URL=\"postgresql://postgres:postgrespassword@localhost:5432/pet_shelter?schema=public\" vitest run --project integration-db",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pretest:all": "npm run db:generate",
    "test:all": "vitest run --project unit --project integration --project components",
    "pretest:coverage": "npm run db:generate",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "tsx scripts/check-drift.ts && prisma db push",
    "db:push:unsafe": "prisma db push",
    "db:push:local": "cross-env DATABASE_URL=\"postgresql://postgres:postgrespassword@localhost:5432/pet_shelter?schema=public\" prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:local": "cross-env DATABASE_URL=\"postgresql://postgres:postgrespassword@localhost:5432/pet_shelter?schema=public\" tsx prisma/seed.ts",
    "db:migrate:faqs": "tsx scripts/migrate-faqs.ts",
    "db:migrate:bulletins": "tsx scripts/migrate-bulletins.ts",
    "db:migrate:bulletins:local": "cross-env DATABASE_URL=\"postgresql://postgres:postgrespassword@localhost:5432/pet_shelter?schema=public\" tsx scripts/migrate-bulletins.ts",
    "db:check-drift": "tsx scripts/check-drift.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "secrets:check": "node scripts/secrets.mjs check",
    "secrets:edit:prod": "node scripts/secrets.mjs edit .env.production.enc",
    "secrets:decrypt:local": "node scripts/secrets.mjs decrypt-to-local .env.production.enc .env.local",
    "secrets:run": "node scripts/secrets.mjs run"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.8.0",
    "@neon/config": "^1.0.0",
    "@neon/env": "^1.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
