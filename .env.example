# pet-shelter Environment Variables Template
# 
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# 
# Node Environment
NODE_ENV=development

# ===== DATABASE =====
# PostgreSQL connection string
# For Neon: Get from https://console.neon.tech
# For local Postgres: postgresql://user:password@localhost:5432/pet_shelter
DATABASE_URL="postgresql://user:password@host:5432/pet_shelter"

# Neon-specific options (optional)
NEON_BRANCH=production
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?channel_binding=require&sslmode=require"

# ===== ADMIN CREDENTIALS =====
# Used for seeding sample admin user in development
# Change these for production!
ADMIN_EMAIL="admin@hopeforstrays.org"
ADMIN_PASSWORD="admin123"

# ===== AUTHENTICATION SECRETS =====
# All three are REQUIRED in production. They are resolved through
# src/lib/security/secrets.ts, which throws at boot when NODE_ENV=production and
# a value is unset, too short, or still equal to its development default.
# Outside production a clearly-labelled insecure fallback is used and warned about.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The values below are DEV_SECRET_DEFAULTS from src/lib/security/secrets.ts,
# verbatim and deliberately. That module rejects a value equal to its own
# development default, so copying this file into a production environment
# unchanged refuses to boot instead of signing cookies with a published key.
# A placeholder unique to this file would defeat that check, so the two lists
# are pinned together by tests/unit/secrets.test.ts.

# Session HMAC secret: signs the hope_shelter_session cookie and derives the
# AES-256 field-encryption key. Minimum 32 characters.
# Rotating this invalidates every live session — all users are signed out.
SESSION_SECRET="dev-only-insecure-session-secret-change-me-before-deploy"

# Shared secret accepted by the legacy admin_session cookie (guards /api/upload).
# Minimum 16 characters.
ADMIN_SECRET_KEY="dev-only-insecure-admin-secret-key-change-me"

# Invite code required to register ANY staff account (all roles, including
# STAFF and VOLUNTEER). Distribute it out-of-band; never commit the real value.
# Recommended: 16+ random characters. Shorter is accepted with a startup
# warning; the length is your call. Still refused at boot in production, in
# any letter case and with or without surrounding quotes: unset, any secret's
# development default (not just this one) or a placeholder an older version of
# this file published, and any code this repository publishes (HOPE2026, 1234,
# the seeded staff passwords).
STAFF_INVITE_SECRET="dev-only-insecure-staff-invite-code-change-me"

# ===== EMAIL SERVICE =====
# Resend SDK for transactional emails
# Get API key from https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# From-address on every outgoing email (src/lib/email.ts). Must be an address on
# a domain verified in Resend; unset leaves it on Resend's shared sandbox sender,
# which does not deliver to arbitrary recipients.
EMAIL_FROM="Hope for Strays <noreply@hopeforstrays.org>"

# Mailbox that receives adoption-application notifications, and the Reply-To on
# mail sent to applicants (src/lib/email.ts).
SHELTER_NOTIFICATION_EMAIL="applications@hopeforstrays.org"

# Public base URL used to build links inside emails (src/lib/email.ts). This is a
# NEXT_PUBLIC_ variable, so it is inlined at build time: changing it requires a
# rebuild, not a restart.
NEXT_PUBLIC_APP_URL="https://hopeforstrays.org"

# ===== ANALYTICS (Optional) =====
# Vercel Web Analytics integration
# Get ID from Vercel dashboard (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# ===== FUTURE INTEGRATIONS (Placeholders) =====
# Stripe (for donations feature)
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# AWS S3 or Supabase Storage (for image uploads)
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="pet-shelter-images"

# ===== LOGGING & DEBUGGING =====
# Prisma logging. src/lib/server/prisma.ts tests `PRISMA_LOG === "true"` exactly and
# then enables the ["error", "warn"] channels — no other value does anything, and
# query logging is not among them.
# PRISMA_LOG="true"

# Enable verbose server logs
# DEBUG="pet-shelter:*"

# ===== STATUTORY IDENTIFIERS =====
# ROS society registration number stamped onto server-issued tax receipts and ROS CSV
# exports. Defaults to the value in src/lib/domain/shelterIdentity.ts. Set this to
# correct the number without a code deploy once the physical ROS certificate is
# confirmed (P2). Server-side only: client-rendered sponsorship receipts read the
# constant directly, so they are unaffected by this variable.
# ROS_REGISTRATION_NO="PPM-021-10-18082021"
