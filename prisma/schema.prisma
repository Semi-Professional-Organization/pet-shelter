// Hope for Strays - Prisma Schema for PostgreSQL
// Multi-Tier Pet Shelter & Adoption Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  // --- Canonical roles ---
  SUPER_ADMIN // Unrestricted platform access, including staff management
  ANIMAL_MANAGER // Pet profiles, gallery photos, QR codes
  CONTENT_EDITOR // FAQs, transparency data, bulletins
  VOLUNTEER_COORDINATOR // Volunteer applications & settings
  STAFF // Standard read-only operational access

  // --- Deprecated aliases, retained so existing rows stay readable ---
  // Postgres cannot drop an enum value while any row references it, and live
  // session cookies still carry these. Normalised on read by
  // normalizeRole() in src/lib/security/permissions.ts. Do not assign.
  ADMIN // -> SUPER_ADMIN
  COORDINATOR // -> VOLUNTEER_COORDINATOR
  VOLUNTEER // -> STAFF
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PetStatus {
  Available
  Pending
  Adopted
  In_Rehabilitation @map("In Rehabilitation")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(STAFF)
  status       UserStatus @default(ACTIVE)
  pinHash      String?
  lastLoginAt  DateTime?
  invitedBy    String?

  // Invitation redemption. The raw token is emailed once and never stored;
  // only its scrypt hash is persisted, mirroring passwordHash.
  inviteTokenHash      String?
  inviteTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@map("users")
}

model Pet {
  id                  String    @id @default(cuid())
  name                String
  species             String // dog, cat, other
  breed               String
  birthDate           String    @default("2024-01-01")
  birthDateIsEstimate Boolean   @default(true)
  gender              String // Male, Female
  size                String // Small, Medium, Large
  weight              String
  status              PetStatus @default(Available)
  adoptionFee         String
  description         String
  rescueStory         String
  image               String
  galleryImages       String[]
  tags                String[]
  featured            Boolean   @default(false)
  intakeDate          String

  // Medical clearance
  vaccinated     Boolean @default(true)
  microchipped   Boolean @default(true)
  spayedNeutered Boolean @default(true)
  specialNeeds   String?

  /// Dedicated donation QR for this animal, overriding the shelter-wide code
  /// wherever this animal's sponsorship modal appears. Set when a specific
  /// rescue is running its own medical fund drive.
  /// Already applied to production, see prisma/sql/2026-09-02-donation-qr-columns.sql
  customQrUrl String?

  // Rehabilitation / TNRM progress (only populated while status is "In Rehabilitation")
  rehabStage           String?
  rehabStageMs         String?
  rehabProgressPercent Int?

  // Compatibility
  goodWithDogs Boolean @default(true)
  goodWithCats Boolean @default(true)
  goodWithKids Boolean @default(true)
  energyLevel  String  @default("Moderate")

  // Soft deletion & audit
  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cost of this animal's care programme, in integer sen, used as the
  /// denominator of the sponsorship progress shown on its profile. Null means
  /// "no animal-specific target", and the shelter-wide default applies.
  sponsorshipGoalSen Int?

  applications       AdoptionApplication[]
  sponsorships       PetSponsorship[]
  updates            PetUpdate[]
  medicalTimeline    MedicalTimelineEvent[]
  vetAssignments     VetPetAssignment[]
  tagAssignments     PetTagAssignment[]
  galleryMedia       PetGalleryImage[]
  compatibilityRules PetCompatibilityRule[]

  @@index([species, status, isArchived])
  @@index([isArchived, status])
  @@index([featured])
  @@map("pets")
}

/// An application to adopt a specific animal.
///
/// ## Why petName and petBreed are copied from Pet
///
/// A normalisation pass reads these as redundant — the data is one join away
/// through `petId` — and deleting them looks like a free 3NF win. It is not, and
/// the reason is visible one line up: `petId` is **nullable**, with
/// `onDelete: SetNull`.
///
/// When a pet row is archived and eventually removed, `petId` becomes null and the
/// join disappears. The application must still say which animal it was for: it is
/// the record of a decision a family and this shelter made on a particular day, it
/// backs the ROS annual return, and an applicant asking "what happened to my
/// application for Tuah" must still get an answer. So these are not a cached copy
/// of a live value; they are a **point-in-time snapshot**, the same pattern an
/// invoice uses when it stores the price a line item sold at rather than joining to
/// today's price list.
///
/// The test for whether a duplicated column is a normalisation defect is whether
/// the two copies are *supposed* to stay equal. Here they are not. Renaming a pet
/// must not retroactively rewrite the applications filed under its old name, in
/// exactly the way `Donation.tierName` must not be rewritten by renaming a tier.
///
/// `Donation` documents the same reasoning for its issuer identity; treat the two
/// as one pattern.
model AdoptionApplication {
  id                    String            @id @default(cuid())
  /// Public reference code (`HFS-APP-YYYYMM-XXXX`) quoted by the applicant to
  /// the tracking portal. Nullable because rows created before it existed are
  /// still addressed by `id`; unique because the portal looks up by it.
  referenceCode         String?           @unique
  petId                 String?
  pet                   Pet?              @relation(fields: [petId], references: [id], onDelete: SetNull)
  /// Snapshot of the pet's name at application time. Deliberately not a join —
  /// see the model comment. Survives `petId` going null.
  petName               String
  /// Snapshot of the pet's breed at application time. Same rationale as petName.
  petBreed              String?
  applicantName         String
  email                 String
  phone                 String
  address               String
  /// NRIC or passport number. Restricted: excluded from the public tracking
  /// DTO and from every notification email. Treat as sensitive PII.
  identification        String?
  housingType           String
  livingSituation       String?
  hasFencedYard         String            @default("yes")
  /// Whether a tenant has their landlord's consent to keep an animal.
  landlordApproval      String?
  currentPets           String            @default("none")
  currentPetDetails     String?
  householdExperience   String            @default("experienced")
  experienceDescription String?           @db.Text
  /// Clinic the applicant intends to register the animal with.
  vetClinic             String?
  /// Bucketed hours the animal would be alone on a normal weekday.
  dailyAloneHours       String?
  applicantNotes        String?           @db.Text
  message               String?           @db.Text
  status                ApplicationStatus @default(SUBMITTED)

  /// Workflow milestones, kept as timestamps rather than `ApplicationStatus`
  /// values. An application can be at the home-visit stage while still being
  /// UNDER_REVIEW, so progress and decision are independent axes. Setting one
  /// of these is what lights a step in the public tracking portal — which
  /// previously had to recover the same facts by regex from `adminReviewNotes`.
  interviewAt           DateTime?
  interviewLocation     String?
  interviewMeetingType  String?
  homeVisitAt           DateTime?
  adminNotes            String?           @db.Text
  adminReviewNotes      String?           @db.Text
  reviewedBy            String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([petId, status])
  @@index([email, petId])
  @@index([email])
  @@map("adoption_applications")
}

/// Narrative progress notes published on a pet's public profile.
///
/// Ids are supplied by the caller (e.g. "up-009-1") rather than generated, so the
/// committed fixtures in src/data/pets.json round-trip through `npm run db:seed`
/// unchanged. `date` is a String in YYYY-MM-DD form on purpose: it matches the
/// domain type and the bilingual formatting in src/lib/medicalTimeline.ts, and a
/// DateTime would introduce timezone drift on a value that has no time component.
model PetUpdate {
  id        String   @id
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  date      String
  title     String
  titleMs   String?
  content   String   @db.Text
  contentMs String?  @db.Text
  image     String?
  // medical, rehabilitation, milestone, socialization
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId, date])
  @@map("pet_updates")
}

/// Clinical history for a pet. This is compliance data — `verified` and
/// `veterinarian` back the ROS AGM exports — so it lives in rows that can be
/// queried across pets, not in a JSON blob. Id and date conventions match
/// PetUpdate above.
model MedicalTimelineEvent {
  id            String        @id
  petId         String
  pet           Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  date          String
  title         String
  titleMs       String?
  // intake, diagnostic, treatment, vaccination, surgery, clearance
  category      String
  description   String        @db.Text
  descriptionMs String?       @db.Text
  veterinarian  String?
  vetId         String?
  vet           Veterinarian? @relation(fields: [vetId], references: [id], onDelete: SetNull)
  verified      Boolean       @default(false)
  badge         String?
  badgeMs       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([petId, date])
  @@index([category, date])
  @@index([vetId])
  @@map("medical_timeline_events")
}

/// An immutable record of a privileged action.
///
/// ## Why details and metadata are unstructured on purpose
///
/// Both look like columns waiting to be normalised: `details` is prose, `metadata`
/// is a JSON blob with no declared shape. Normalising either is an anti-pattern
/// here, because an audit log's whole value is being a faithful record of what the
/// system looked like **at write time**.
///
/// A typed column means a later migration rewrites, reinterprets, or drops entries
/// written under the old shape — and an audit trail that changes retroactively is
/// not evidence of anything. Keeping the payload schemaless means a row written
/// today still reads exactly as it was written after the surrounding models have
/// moved on. That is the trade being made: queryability is given up deliberately,
/// in exchange for the one property this table exists to have.
///
/// `actorEmail` and `actorRole` are snapshots for the same reason as
/// `AdoptionApplication.petName` — the actor's role at the time of the action, not
/// their role now. A user demoted next year must not appear to have been demoted
/// when they took the action.
///
/// Contrast `MedicalTimelineEvent`, which is compliance data that *must* be queried
/// across pets and therefore does get real columns.
model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actorId      String?
  /// Snapshot of the actor's identity at write time; not a join to User.
  actorEmail   String
  /// Snapshot of the actor's role at write time. See the model comment.
  actorRole    String
  targetEntity String
  targetId     String?
  /// Human-readable prose. Deliberately unstructured — see the model comment.
  details      String
  /// Free-form payload whose shape belongs to the action that wrote it.
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail])
  @@map("audit_logs")
}

model ShelterSettings {
  id                 String  @id @default("default-settings")
  shelterName        String  @default("Hope for Strays")
  email              String  @default("info@hopeforstrays.org")
  phone              String  @default("03-7876 5432")
  address            String  @default("No. 18, Jalan SS 2/72, 47300 Petaling Jaya, Selangor, Malaysia")
  operatingHours     String  @default("Tuesday – Sunday: 10:00 AM – 5:00 PM")
  announcementBanner String?
  adoptionFeeDog     String  @default("Free")
  adoptionFeeCat     String  @default("Free")

  /// Fallback care-cost target in integer sen (RM 1,500.00) for any animal
  /// without a `Pet.sponsorshipGoalSen` of its own.
  defaultSponsorshipGoalSen Int @default(150000)

  /// Volunteer intake runs through an external Google Form rather than an in-app
  /// pipeline. `volunteerFormUrl` is the public application form linked from the
  /// volunteer section of /get-involved; `volunteerFormResponsesUrl` is the
  /// coordinator-only responses sheet linked from the admin header. Deliberately
  /// two URLs: the form and its responses live at different addresses.
  /// Already applied to production, see prisma/sql/2026-09-02-add-volunteer-form-urls.sql
  volunteerFormUrl          String @default("https://docs.google.com/forms/d/e/REPLACE_WITH_YOUR_FORM_ID/viewform")
  volunteerFormResponsesUrl String @default("https://docs.google.com/spreadsheets/d/REPLACE_WITH_YOUR_SHEET_ID/edit")

  /// Donation QR codes, one per Malaysian payment rail. DuitNow is the default
  /// and is always offered to donors; the other two surface a tab on the
  /// donation panel only once an image is uploaded for them.
  ///
  /// `paymentPayload` is a DuitNow EMVCo string (or a bank deep link) that we
  /// render to an SVG QR ourselves when no `duitNowQrUrl` image is set. It is
  /// specific to the DuitNow rail and is never used for the other two.
  /// Already applied to production, see prisma/sql/2026-09-02-donation-qr-columns.sql
  duitNowQrUrl   String?
  tngQrUrl       String?
  bankQrUrl      String?
  paymentPayload String?

  // Email Configuration (Optional overrides)
  resendApiKey String?
  emailFrom    String? @default("Hope for Strays <onboarding@resend.dev>")

  // Storage Configuration (Optional overrides)
  storageProvider     String? @default("local")
  s3Bucket            String?
  s3Region            String? @default("ap-southeast-1")
  s3Endpoint          String?
  cloudinaryCloudName String?

  updatedAt DateTime @updatedAt

  @@map("shelter_settings")
}

/// Allocator backing gapless receipt numbering. One row per numbering scope
/// (currently one per calendar month, e.g. "HFS-DON-202608").
///
/// ## Why a counter row and not a Postgres SEQUENCE
///
/// A `SEQUENCE` is faster and lock-free, but it is explicitly **not gapless**: a
/// rolled-back transaction consumes its drawn value permanently. For an ordinary
/// surrogate key that is fine. For a statutory receipt series it is not — an
/// auditor reconciling an ROS annual return reads a missing number as a destroyed
/// or concealed receipt, and "our sequence had a gap" is not a defence.
///
/// Incrementing a row inside the same transaction that inserts the `Donation`
/// makes the two atomic: the number is consumed if and only if the receipt exists.
/// Concurrent donors serialise on this row's write lock, which for an NGO's volume
/// costs nothing measurable and is the standard gapless-invoice pattern.
model ReceiptSequence {
  /// The receipt-number prefix this counter serves, e.g. "HFS-DON-202608".
  scope     String   @id
  /// Highest value issued in this scope. The next receipt is `lastValue + 1`.
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("receipt_sequences")
}

/// An issued LHDN Section 44(6) tax-deductible donation receipt.
///
/// ## Append-only by construction
///
/// This is a statutory document, not application state. There is deliberately no
/// `updatedAt` column and no update or delete path in `src/lib/server/donationLedger.ts`:
/// a receipt that can be edited after issue is not evidence of anything. A
/// correction is issued as a new offsetting record, the way an accounting ledger
/// handles one. `prisma/sql/donation_append_only.sql` adds the matching database
/// trigger for deployments that want the guarantee enforced below the ORM too.
///
/// ## Why the issuer identity is copied onto every row
///
/// `taxDeductibleRef` and `shelterRegistrationNo` duplicate constants that live in
/// `src/lib/domain/shelterIdentity.ts`, which a normalisation pass would flag as
/// redundant. It is intentional, and it is the same point-in-time capture pattern
/// as `AdoptionApplication.petName`: a receipt must forever show the identifiers it
/// was *issued* under. Resolving the ROS registration discrepancy (P2) must not
/// retroactively rewrite receipts already in donors' hands and in LHDN filings.
///
/// ## Money
///
/// `amountSen` is an integer count of sen (1/100 MYR) — never a float, never a
/// string. See the rationale in `src/lib/domain/money.ts`.
model Donation {
  id            String @id @default(cuid())
  /// Human-facing receipt identifier, e.g. "HFS-DON-202608-0001".
  receiptNumber String @unique
  /// The `ReceiptSequence.scope` this number was drawn from.
  sequenceScope String
  /// The value drawn from that scope. Unique per scope, contiguous from 1.
  sequenceValue Int

  donorName  String
  donorEmail String
  donorPhone String?
  /// Malaysian IC, tax file, or SSM number the donor will claim the relief against.
  taxIdOrIc  String?

  tierId        String
  /// Tier name as displayed at donation time. Snapshot, for the same reason as the
  /// issuer identity above: renaming a sponsorship tier must not alter old receipts.
  tierName      String
  /// Integer sen. RM 250.00 is stored as 25000.
  amountSen     Int
  currency      String  @default("MYR")
  frequency     String  @default("one_time")
  paymentMethod String
  /// Free-text dedication ("in honour of Barnaby"), not a foreign key — the pledge
  /// form collects a name, and the dedication should survive the pet being archived.
  targetPetName String?
  notes         String? @db.Text

  taxDeductibleRef      String
  shelterRegistrationNo String

  issuedAt DateTime @default(now())

  /// Makes a double-allocation a database error rather than two receipts sharing a
  /// number. The unique index is the real guarantee; the transaction is the mechanism.
  @@unique([sequenceScope, sequenceValue])
  @@index([issuedAt])
  @@index([donorEmail])
  @@map("donations")
}

/// A general gift a supporter says they have sent, before anyone has checked.
///
/// ## Why this is not a `Donation`
///
/// The same reason `PetSponsorship` is not one, and it applies here with less
/// ambiguity: a `Donation` is an issued receipt, and until a coordinator has
/// matched the transfer against the bank statement there is nothing to issue a
/// receipt *for*. All the application knows is that somebody filled in a form and
/// was shown a DuitNow QR.
///
/// Until 2026-09-22 the general-donation form allocated an `HFS-DON-*` number the
/// moment it was submitted, so anyone could mint a Section 44(6) tax document from
/// a public form without sending money. The defect and the fix are recorded in
/// `tasks/decisions/2026-09-22-general-gifts-become-pending-until-reconciled.md`,
/// which settled the open entry that reported it. Reconciliation is the issuance
/// boundary, exactly as for a sponsorship.
///
/// ## Why the pending state could not live on `Donation`
///
/// Production enforces `prisma/sql/donation_append_only.sql` below the ORM
/// (`donations_no_mutation`, applied 2026-09-21). A pending row written into
/// `donations` could never be updated to attach its receipt number: the trigger
/// refuses every UPDATE. A status column on a statutory document was already
/// forbidden by the `Donation` comment; the trigger makes it impossible as well.
///
/// ## What the statutory export sees
///
/// Nothing here. `fetchDonationReceiptsAction` reads `donations`, so an
/// unreconciled gift cannot reach an LHDN return however this table is queried.
/// That is deliberately structural rather than a `where` clause somebody has to
/// remember — the defect being fixed was a silent one.
model DonationPledge {
  id String @id @default(cuid())

  donorName  String
  donorEmail String
  donorPhone String?
  /// Captured at checkout and copied onto the receipt at reconciliation. Never
  /// projected into the coordinator's queue — confirming that a transfer landed
  /// does not require reading anybody's NRIC.
  taxIdOrIc  String?

  tierId    String
  /// Tier name as displayed at pledge time, snapshotted for the same reason as
  /// `Donation.tierName`: a later rename of the catalog must not rewrite history.
  tierName  String
  /// Integer sen. RM 250.00 is stored as 25000.
  amountSen Int
  currency  String @default("MYR")
  frequency String @default("one_time")

  paymentMethod String
  /// PENDING_PAYMENT -> ACTIVE | CANCELLED. A plain String with a Zod boundary,
  /// matching `PetSponsorship.status`: converting a text column to a Postgres enum
  /// needed a hand-written, rehearsed migration here once already
  /// (`prisma/migrations/manual/20260917_status_enums/`), and this column earns
  /// none of that cost.
  status        String @default("PENDING_PAYMENT")

  /// Free-text dedication ("in honour of Barnaby"), not a foreign key — same
  /// contract as `Donation.targetPetName`, which this is copied to at issuance.
  /// A gift naming an animal is still a general gift: a commitment to fund one
  /// animal's care is a `PetSponsorship`.
  targetPetName String?
  notes         String? @db.Text

  /// Handed to the donor at checkout so they can quote it on their transfer.
  /// Prefixed HFS-GFT: distinguishable at a glance both from an `HFS-DON` receipt
  /// and from a sponsorship's `HFS-PLG` claim, which a coordinator reading one
  /// bank statement against two queues needs.
  pledgeRef     String  @unique
  /// The `Donation.receiptNumber` issued for this gift, once reconciled. Unique,
  /// so a second confirmation cannot attach a second statutory receipt to the
  /// same money.
  receiptNumber String? @unique

  reconciledAt DateTime?
  reconciledBy String?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the coordinator's queue: pending rows, oldest first.
  @@index([status, createdAt])
  @@index([donorEmail])
  @@map("donation_pledges")
}

/// A donor who has claimed a sponsor portal account.
///
/// Separate from `User`, which is staff. Sponsors authenticate through their own
/// cookie namespace — see `src/lib/security/sponsorSession.ts` for why the two are
/// not unified.
model Sponsor {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String
  passwordHash  String
  /// Consent to appear on the public wall. The sponsor's current answer; each
  /// donation also records the answer given at the time it was made.
  displayOnWall Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sponsorships PetSponsorship[]

  @@index([displayOnWall])
  @@map("sponsors")
}

/// Licensed veterinarian participating in shelter clinical operations.
model Veterinarian {
  id            String   @id @default(cuid())
  name          String
  licenseNumber String   @unique
  clinicName    String?
  phone         String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  specializations VetSpecialization[]
  petAssignments  VetPetAssignment[]
  timelineEvents  MedicalTimelineEvent[]

  @@map("veterinarians")
}

/// Catalog of standard veterinary clinical procedures and compliance categories.
model MedicalProcedureCategory {
  id          String  @id // intake, diagnostic, treatment, vaccination, surgery, clearance
  name        String
  nameMs      String?
  description String? @db.Text

  specializations VetSpecialization[]

  @@map("medical_procedure_categories")
}

/// 5NF Join: Veterinarian Specializations (Vet x Procedure Category).
/// Enforces that a vet is qualified/certified to perform procedures in this category.
model VetSpecialization {
  vetId        String
  categoryId   String
  certifiedAt  DateTime                 @default(now())
  veterinarian Veterinarian             @relation(fields: [vetId], references: [id], onDelete: Cascade)
  category     MedicalProcedureCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([vetId, categoryId])
  @@map("vet_specializations")
}

/// 5NF Join: Vet Care Assignments (Vet x Pet Primary Care).
/// Establishes formal veterinary custody and attending physician assignment for a pet.
model VetPetAssignment {
  vetId        String
  petId        String
  assignedAt   DateTime     @default(now())
  isPrimary    Boolean      @default(true)
  veterinarian Veterinarian @relation(fields: [vetId], references: [id], onDelete: Cascade)
  pet          Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@id([vetId, petId])
  @@map("vet_pet_assignments")
}

/// 4NF Normalization: Normalized lookup table for pet tags.
model PetTag {
  id          String             @id
  name        String             @unique
  category    String? // Temperament, Physical, Medical, Lifestyle
  assignments PetTagAssignment[]

  @@map("pet_tags")
}

/// 4NF Join: Pet to Tag mapping.
model PetTagAssignment {
  petId String
  tagId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  tag   PetTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([petId, tagId])
  @@map("pet_tag_assignments")
}

/// 4NF Media: Normalized gallery images with explicit ordering and metadata.
model PetGalleryImage {
  id           String   @id @default(cuid())
  petId        String
  url          String
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  pet          Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, displayOrder])
  @@map("pet_gallery_images")
}

/// 5NF Join: Pet Compatibility Matrix (Pet x Housing Type x Cohabitant Type).
/// Expresses multi-dimensional lifestyle compatibility constraints for the match engine.
model PetCompatibilityRule {
  id             String  @id @default(cuid())
  petId          String
  housingType    String // condo_apartment, landed_no_yard, landed_fenced_yard
  cohabitantType String // toddlers, resident_dogs, resident_cats, elderly
  isAllowed      Boolean @default(true)
  notes          String? @db.Text
  pet            Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, housingType, cohabitantType])
  @@index([petId])
  @@map("pet_compatibility_rules")
}

/// A supporter's standing commitment to fund one animal's care.
///
/// ## Why this is not a `Donation`
///
/// `Donation` is an issued receipt: append-only, immutable, and evidence that
/// money arrived. A sponsorship is the opposite kind of record — a commitment
/// that has a lifecycle, can be waiting on a bank transfer, and can be
/// cancelled. Modelling it as a mutable `Donation` would have meant putting a
/// status column on a statutory document, which is exactly what that model's
/// comment forbids.
///
/// The two meet at reconciliation: when a coordinator matches the transfer,
/// `issueDonationReceipt()` writes the `Donation` and its gapless number is
/// copied onto `receiptNumber` here. Until that happens this row carries no
/// receipt number, because nothing has verified that any money moved — the
/// supporter was shown a DuitNow QR and told us they paid.
///
/// ## Money
///
/// `amountSen` is an integer count of sen, as everywhere else. See
/// `src/lib/domain/money.ts`.
model PetSponsorship {
  id String @id @default(cuid())

  /// Nullable, and paired with a denormalised name. Pets are still served from
  /// `src/data/pets.json` through an in-memory store when the database is empty,
  /// so a sponsorship can legitimately name an animal that has no row here. The
  /// snapshot is also what keeps the record readable after a rename or an
  /// archive, the same reasoning as `AdoptionApplication.petName`.
  petId   String?
  pet     Pet?    @relation(fields: [petId], references: [id], onDelete: SetNull)
  petName String

  sponsorName  String
  sponsorEmail String
  sponsorPhone String?
  /// The supporter account that claims this commitment, once one exists. Checkout is
  /// still guest-only, so this is null at creation and filled in when the donor claims
  /// their portal account — see `registerSponsorAction`. Nullable and `SetNull` because a
  /// commitment outlives an account: deleting the account must not erase the record that
  /// the money was pledged.
  userId       String?
  sponsor      Sponsor? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Public Sponsor Wall consent, as given at this checkout. Recorded per commitment
  /// rather than per account because most supporters have no account when they give; the
  /// account inherits it when the commitment is claimed.
  displayOnWall Boolean @default(false)

  tierId    String
  /// Tier name as displayed when the commitment was made, snapshotted for the
  /// same reason as `Donation.tierName`.
  tierName  String
  /// "one_time" or "monthly". A plain String, matching `Donation.frequency`,
  /// constrained at the Zod boundary rather than by a database enum.
  frequency String @default("one_time")
  /// Integer sen. RM 80.00 is stored as 8000.
  amountSen Int

  paymentMethod String
  /// PENDING_PAYMENT -> ACTIVE | CANCELLED | EXPIRED. Only ACTIVE counts toward
  /// the public supporter tally and the funding total.
  status        String @default("PENDING_PAYMENT")

  /// Handed to the supporter at checkout so they can quote it on their transfer.
  /// Prefixed HFS-PLG, deliberately unlike a receipt number: a coordinator
  /// reading a bank statement must be able to tell a claim from a receipt.
  pledgeRef     String  @unique
  /// The `Donation.receiptNumber` issued for this commitment, once reconciled.
  /// Unique, so a second reconciliation cannot attach a second receipt to the
  /// same money.
  receiptNumber String? @unique

  reconciledAt DateTime?
  reconciledBy String?
  cancelledAt  DateTime?

  taxIdOrIc String?
  notes     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the per-animal supporter count and funding total.
  @@index([petId, status])
  @@index([sponsorEmail])
  @@index([userId])
  @@map("pet_sponsorships")
}

// ---------------------------------------------------------------------------
// Financial transparency ("Where Your Money Goes")
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  MEDICAL
  FOOD_NUTRITION
  SHELTER_MAINTENANCE
  RESCUE_TNRM
  STAFF_CARE
}

/// A single verified shelter expense. Public allocation percentages are DERIVED
/// from these rows, never stored, so the chart can never drift from the ledger.
model ExpenseItem {
  id             String          @id @default(cuid())
  category       ExpenseCategory
  title          String
  /// Amount in sen (1/100 MYR). Integer money: no floating point rounding.
  amountSen      Int
  /// ISO-8601 calendar date, "YYYY-MM-DD". Enforced by Zod at every write path
  /// so lexicographic ordering equals chronological ordering.
  date           String
  vendorOrClinic String?
  petName        String?
  /// Vendor invoice / clinic receipt reference: what makes an entry "verified".
  receiptRef     String?
  isPublished    Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isPublished, date])
  @@index([category])
  @@map("expense_items")
}

/// Downloadable audit / spending report filed for ROS and AGM compliance.
model FinancialReport {
  id          String   @id @default(cuid())
  year        Int
  /// 1-12 for a monthly statement; null for an annual report.
  month       Int?
  title       String
  fileUrl     String
  summary     String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Backstop for the duplicate check in `createFinancialReport`, which is a
  /// non-atomic read-then-write and so cannot stop two concurrent submits on its
  /// own. Postgres treats NULLs as distinct in a unique index, so this covers
  /// monthly statements; annual reports (month = null) still rely on the code
  /// check alone.
  @@unique([year, month, title])
  @@index([isPublished, year, month])
  @@map("financial_reports")
}

/// Headline impact counter shown on the public transparency page.
model ImpactStat {
  id           String   @id @default(cuid())
  key          String   @unique
  /// Free-form so "180", "42", "100%" and "RM 0" are all expressible.
  metricValue  String
  label        String
  labelMs      String?
  period       String
  periodMs     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("impact_stats")
}

/// Per-email-address notification consent.
///
/// Keyed by email rather than by account because a supporter need not have one:
/// `User` is staff-only, and the `Sponsor` portal account is optional and claimed
/// after the fact. The address is the identity every supporter has, so a signed
/// token mailed to it is the only credential the preference page can accept.
///
/// Deliberately separate from `PetSponsorship.displayOnWall`, which is consent to be
/// *listed publicly* rather than consent to be *emailed*. Withdrawing one must not
/// withdraw the other.
///
/// A missing row means "has never expressed a choice", which reads as opted in.
/// Rows appear only when someone actually changes something, so this table stays
/// small and every row in it is a deliberate statement by a donor.
model NotificationPreference {
  id    String @id @default(cuid())
  email String @unique

  /// Photos of animals this address sponsors, sent by their caregivers.
  photoUpdates Boolean @default(true)
  /// Shelter news and appeals.
  newsletter   Boolean @default(true)

  /// Set when every channel is off, so a global unsubscribe is auditable as one
  /// event rather than inferred from two booleans.
  unsubscribedAllAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

/// Category vocabulary for the public FAQ.
///
/// Deliberately identical to the `FaqCategory` union in src/types/faq.ts and to
/// the keys of FAQ_CATEGORY_LABELS in src/lib/presentation/categoryTabs.ts,
/// which remains the single declaration of the labels. The three are held in
/// step by a compile-time assertion in src/lib/server/faqRepository.ts: adding
/// a member here without adding it there is a type error, not a category that
/// silently renders as its own raw value.
enum FaqCategory {
  tnrm
  sponsorship
  adoption
  visiting
  get_involved
  general
  medical
}

/// Staff-editable FAQ knowledge base behind /faq and /admin/faqs.
///
/// Replaces the read-only src/data/faqs.json catalog, which is retained as the
/// offline fallback fixture in the same way pets.json backs the Pet repository.
model Faq {
  id       String      @id @default(cuid())
  category FaqCategory
  question String
  answer   String      @db.Text

  /// Bahasa Malaysia copy. Nullable because staff may publish an English entry
  /// and translate it later; the repository resolves the English text in its
  /// place when mapping to FaqItem, so no reader ever sees a blank Malay
  /// question and every consumer keeps a plain `string`. Storing the null
  /// rather than a copy of the English means a later edit to the English text
  /// still shows through instead of leaving a stale duplicate behind.
  questionMs String?
  answerMs   String? @db.Text

  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, category, displayOrder])
  @@index([category, displayOrder])
  @@map("faqs")
}
