{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(./package-lock.json)",
      "Read(./.next/**)",
      "Read(./node_modules/**/*.js)",
      "Read(./node_modules/**/*.mjs)",
      "Read(./node_modules/**/*.cjs)",
      "Read(./node_modules/**/*.map)",
      "Read(./.deepsec/node_modules/**)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(npm run db:push)",
      "Bash(npm run db:push:unsafe*)",
      "Bash(npm run db:seed)",
      "Bash(npm run db:migrate:faqs*)",
      "Bash(npx tsx scripts/migrate-faqs.ts*)",
      "Bash(tsx scripts/migrate-faqs.ts*)",
      "Bash(npm run db:migrate:bulletins)",
      "Bash(npm run db:migrate:bulletins *)",
      "Bash(npx tsx scripts/migrate-bulletins.ts*)",
      "Bash(tsx scripts/migrate-bulletins.ts*)",
      "Bash(npm run secrets:decrypt:local*)",
      "Bash(node scripts/secrets.mjs decrypt-to-local*)",
      "Bash(npm run secrets:run*)",
      "Bash(node scripts/secrets.mjs run*)",
      "Bash(npm run secrets:edit*)",
      "Bash(node scripts/secrets.mjs edit*)",
      "PowerShell(npm run db:migrate:faqs*)",
      "PowerShell(npx tsx scripts/migrate-faqs.ts*)",
      "PowerShell(tsx scripts/migrate-faqs.ts*)",
      "PowerShell(npm run db:migrate:bulletins)",
      "PowerShell(npm run db:migrate:bulletins *)",
      "PowerShell(npx tsx scripts/migrate-bulletins.ts*)",
      "PowerShell(tsx scripts/migrate-bulletins.ts*)",
      "PowerShell(npm run secrets:decrypt:local*)",
      "PowerShell(node scripts/secrets.mjs decrypt-to-local*)",
      "PowerShell(npm run secrets:run*)",
      "PowerShell(node scripts/secrets.mjs run*)",
      "PowerShell(npm run secrets:edit*)",
      "PowerShell(node scripts/secrets.mjs edit*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma db execute*)",
      "Bash(npx prisma migrate*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean -f*)",
      "Bash(git stash*)",
      "Bash(git commit --amend*)",
      "Bash(git rebase *)",
      "Bash(git branch -D*)",
      "Bash(rm -rf *)",
      "Bash(npm run ledger:issues *--apply*)",
      "Bash(node scripts/ledger-issues.mjs *--apply*)",
      "PowerShell(npm run ledger:issues *--apply*)",
      "PowerShell(node scripts/ledger-issues.mjs *--apply*)",
      "Bash(npm run issues:groups *--apply*)",
      "Bash(node scripts/issue-groups.mjs *--apply*)",
      "PowerShell(npm run issues:groups *--apply*)",
      "PowerShell(node scripts/issue-groups.mjs *--apply*)"
    ],
    "allow": [
      "gh pr merge"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent.mjs\" orient --brief --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent.mjs\" meter --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|BashOutput|KillShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-guard.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent.mjs\" meter --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
